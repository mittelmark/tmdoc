# Editor backup files
*~

# Fetched / vendored third-party modules. These are downloaded on demand by
# `make` from pinned commits (see the *_REF variables in the Makefile), so they
# are NOT tracked in this repo.  Only `modules/tmdoc/` (the project's own
# source) is tracked.
modules/fileutil/
modules/yaml/
modules/cmdline/
modules/bibtex/
modules/markdown/
modules/textutil/
modules/citer/
modules/tdot/
modules/tsvg/
modules/tblocks/
modules/tcrd/

# Test outputs generated by `make test`
modules/tmdoc/images/
modules/tmdoc/include.md
modules/tmdoc/*.png
modules/tmdoc/*.svg
modules/tmdoc/chunk-shell-*.txt
modules/tmdoc/chunk-shell-*.c
modules/tmdoc/chunk-shell-*.py
modules/tmdoc/file.ext
modules/tmdoc/hello
modules/tmdoc/hello2
modules/tmdoc/kroki/
modules/tmdoc/*.toc

# Build output
app-build/
tmdoc.vfs/
tmdoc.tapp
tmdoc.tcl
tmdoc.tb64
tmdoc.tb64.lz4
tmdoc.ttcl

# Prebuilt standalone binaries (released as GitHub release assets)
bin/*.bin
